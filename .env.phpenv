# This env file is for phpenv.
# See https://github.com/phpenv/phpenv
# For example, to install PHP 8.4.21:
#     source .env.phpenv
#     phpenv install -v 8.4.21
#     phpenv local 8.4.21
#     phpenv rehash

# We need Gnu Multiple Precision for big integers
# https://www.php.net/manual/en/book.gmp.php

export PHP_BUILD_CONFIGURE_OPTS="
--with-gmp
"

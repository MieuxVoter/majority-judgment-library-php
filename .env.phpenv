# This env file is for phpenv.
# See https://github.com/phpenv/phpenv
# For example, to install PHP 8.4.21:
#     source .env.phpenv
#     phpenv install -v 8.4.21
#     phpenv local 8.4.21
#     phpenv rehash

# We need Gnu Multiple Precision for big integers
# https://www.php.net/manual/en/book.gmp.php

# EDIT: no we don't ; we decided to skip big integers for portability,
# at the cost of not handling amounts of voters greater than 3 billion.
# Still, at some point we might want to support big integers, so this stays.

export PHP_BUILD_CONFIGURE_OPTS="
--with-gmp
"
